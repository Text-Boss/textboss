    {
      "parameters": {
        "jsCode": "const fs = require('fs');\nconst path = require('path');\n\n// Use n8n variable or fallback to relative path in the current project\n// Note: n8n usually runs from its own directory, so we use an absolute path resolved from process.cwd() \n// assuming n8n is started from the project root.\nconst calPath = $vars.CALENDAR_PATH || path.join(process.cwd(), 'marketing/content-calendar/approved/reddit_calendar.json');\n\nif (!fs.existsSync(calPath)) return [];\n\nconst calendar = JSON.parse(fs.readFileSync(calPath, 'utf8'));\nconst now = new Date();\nconst windowMs = 5 * 60 * 1000;\n\nconst due = calendar.filter(post => {\n  if (post.status !== 'approved') return false;\n  const postTime = new Date(post.scheduled_time);\n  return postTime >= now && postTime <= new Date(now.getTime() + windowMs);\n});\n\nreturn due.map(post => ({ json: post }));"
      },
